{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Infrastructure - Virtual Environment Server",
	//
	// Required:
	//		The protocol is the endpoint protocol
	//
	"protocol": "venv_server://",
	//
	// Required:
	//		Class type of the node - what it does
	//
	"classType": [],
	//
	// Required:
	//		Capabilities are flags that change the behavior of the underlying
	//		engine. `internal` keeps this node out of services.json (never in the
	//		palette, never user-placed); it is synthesized by the partitioner.
	//
	"capabilities": ["internal"],
	//
	// Optional:
	//		Description to of this driver
	//
	"description": ["An internal infrastructure component that runs inside a virtual-environment child process, receiving bridged pipeline lane data and applying it to the local (venv) pipeline, and shipping any results back."],
	//
	// Optional:
	//		Register is either filter, endpoint or ignored if not specified. If the
	//		type is specified, a factory is registered of that given type
	//
	"register": "filter",
	//
	// Optional:
	//		The node is the actual physical node to instantiate - if
	//		not specified, the protocol will be used
	//
	"node": "python",
	//
	// Optional:
	//		The path is the executable/script code - it is node dependent
	// 		and is optional for most node
	//
	"path": "nodes.venv.server",
	//
	// Required:
	//		The prefix map when added/removed when convertting URLs <=> paths
	//
	"prefix": "Venv Server",
	//
	//	Optional:
	//		Passthrough lane map (each bridgeable lane maps to itself). Required so a
	//		child forward-ingress -- which reads a lane from the child source stub AND
	//		emits the same lane to a group node -- passes the task-file validator's
	//		input/output lane-linking (which consults this map). The node is a transparent
	//		bridge, so it declares every bridgeable lane (all except non-bridgeable
	//		`words`). The `venv` client's round-trip node carries the same map.
	//
	"lanes": {
		"tags": ["tags"],
		"text": ["text"],
		"table": ["table"],
		"json": ["json"],
		"audio": ["audio"],
		"video": ["video"],
		"image": ["image"],
		"questions": ["questions"],
		"answers": ["answers"],
		"classifications": ["classifications"],
		"classificationContext": ["classificationContext"],
		"documents": ["documents"]
	}
}
