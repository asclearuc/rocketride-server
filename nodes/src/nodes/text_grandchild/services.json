{
	//
	// Required:
	//		The displayable name of this node
	//
	"title": "Text Grandchild",
	//
	// Required:
	//		The protocol; the logical type (`text_grandchild`) is derived from it and is the
	//		`provider` used in a pipeline document.
	//
	"protocol": "text_grandchild://",
	//
	// Required:
	//		Class type of the node - a text filter.
	//
	"classType": ["text"],
	//
	// Required:
	//		No special capabilities.
	//
	"capabilities": [],
	//
	// Optional:
	//		Description of this driver.
	//
	"description": ["A test fixture for orphan-safe teardown (§7 step 8.5B). Spawns a long-running child process of its own and emits that PID as its text, so a test can assert the process tree is bounded by the OS rather than by cooperation. A grandchild of the server has neither the --autoterm stdin monitor nor a pipe from the server, which is the exact class this fixture exists to represent."],
	//
	// Optional:
	//		Register a python filter factory for this node.
	//
	"register": "filter",
	//
	// Optional:
	//		The node is a python node.
	//
	"node": "python",
	//
	// Optional:
	//		The python package implementing the node.
	//
	"path": "nodes.text_grandchild",
	//
	// Required:
	//		The prefix map when added/removed when converting URLs <=> paths.
	//
	"prefix": "text_grandchild",
	//
	//	Optional:
	//		Consumes text, produces text (the spawned PID).
	//
	"lanes": {
		"text": ["text"]
	}
}
